{
  "description": "Acende os agentes do Kit 6x1 no painel ao vivo.",
  "hooks": {
    "SubagentStart": [
      {"matcher": "^kit-6x1:", "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook_painel.py"], "timeout": 10}]}
    ],
    "SubagentStop": [
      {"matcher": "^kit-6x1:", "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook_painel.py"], "timeout": 10}]}
    ]
  }
}
